% Public usage guide:
% - Keep these comments in sync with the command signatures and behavior any
%   time this package changes.
% - \vsmIndustry[<node name>]{<position>}
% - \vsmInventory[<node name>]{<position>}{<label text>}
% - \vsmSupermarket[<node name>]{<position>}{<name text>}
% - \vsmDataBox[<node name>]{<position or parent node>}{<row 1>|<row 2>|...}
% - \vsmProcess[<node name>]{<position>}{<title>}{<description>}[<worker count>][<parallel count>]
% - \vsmLeadTimeLadder[<totals box node name>]{<type>/<linked node>/<time>,...}{<lead time total>}{<process time total>}
% - \vsmWorkcell[<node name>]{<position>}{<label text>}
% - \vsmKaizenBurst[<node name>]{<position>}{<text line 1>\\<text line 2>}
% - \vsmDeliveryArrow[<draw options>][<textbox text>]{<from>}{<to>}
% - \vsmManualInformationFlow[<draw options>]{<from>}{<to>}
% - \vsmElectronicInformationFlow[<draw options>][<textbox text>]{<from>}{<to>}
% - \vsmPushArrow[<draw options>][<textbox text>]{<from>}{<to>}
% - \vsmFIFOArrow[<node name>][<draw options>]{<from>}{<to>}{<max cap count>}
% - \vsmConveyor[<node name>][<draw options>]{<from>}{<to>}

\RequirePackage{tikz}
\RequirePackage{xparse}
\usetikzlibrary{arrows.meta,backgrounds,calc,fit,matrix,positioning,shapes.multipart,shapes.geometric}
\pgfdeclarelayer{vsm foreground}
\pgfsetlayers{background,main,vsm foreground}

% Draw an industry/customer box.
% #1 optional TikZ node name for later references; defaults to Customer.
% #2 coordinate where the symbol is centered.
\newcommand{\vsmIndustry}[2][Customer]{%
  \node[rectangle, minimum width=3cm, minimum height=1cm] (#1) at (#2) {#1};
  \draw (#1.south west) -- (#1.south east) -- (#1.north east) --++
  (0,5mm) --++ (-1cm,-5mm) --++ (0,5mm) --++ (-1cm,-5mm) --++ (0,5mm) --
  (#1.north west) -- cycle;
}

% Draw an inventory triangle.
% #1 optional TikZ node name for later references; defaults to Inventory.
% #2 coordinate where the triangle is centered.
% #3 label text shown beneath the triangle; use \\ for internal line breaks.
\newcommand{\vsmInventory}[3][Inventory]{%
  \node[
    draw,
    regular polygon,
    regular polygon sides=3,
    minimum height=1.5cm,
    label={[label distance=1em]270:{\footnotesize \shortstack[c]{#3}}}
  ] (#1) at (#2) {I};
}

% Draw a supermarket symbol: an open-left shelving bracket made of a right
% spine plus four evenly spaced horizontal bars (top, two dividers, bottom),
% matching the classic VSM "supermarket" pull-shelf icon.
% #1 optional TikZ node name for later references; defaults to Supermarket.
% #2 coordinate where the symbol is centered.
% #3 name text that fills the top compartment; use \\ for internal line breaks.
% The node itself keeps normal rectangle anchors (north/south/east/west/...),
% so it can still be used as an anchor for \vsmDataBox, arrows, and
% \vsmLeadTimeLadder like any other VSM symbol.
\newcommand{\vsmSupermarket}[3][Supermarket]{%
  \node[minimum width=2cm, minimum height=1.8cm, inner sep=0pt] (#1) at (#2) {};
  \draw[line width=1.1pt]
  (#1.north west) -- (#1.north east) -- (#1.south east) -- (#1.south west);
  \draw[line width=1.1pt]
  ($(#1.north west)!0.3333!(#1.south west)$) --
  ($(#1.north east)!0.3333!(#1.south east)$);
  \draw[line width=1.1pt]
  ($(#1.north west)!0.6667!(#1.south west)$) --
  ($(#1.north east)!0.6667!(#1.south east)$);
  \node[align=center, text width=2cm, font=\footnotesize]
  at ($(#1.north)!0.1667!(#1.south)$) {#3};
}

\ExplSyntaxOn
\dim_new:N \l__vsm_databox_width_dim
\seq_new:N \l__vsm_databox_items_seq
\tl_new:N \l__vsm_databox_body_tl
\tl_new:N \l__vsm_databox_anchor_tl
\tl_new:N \l__vsm_databox_position_tl

\msg_new:nnn { vsm-commands } { missing-data-items }
{ \string\vsmDataBox\space requires at least one data element. }

\msg_new:nnn { vsm-commands } { invalid-worker-count }
{
  \string\vsmProcess\space worker~count~'#1'~is~not~a~positive~integer;~the~
  worker~icon~will~be~hidden.
}

\msg_new:nnn { vsm-commands } { invalid-parallel-count }
{
  \string\vsmProcess\space parallel~count~'#1'~is~not~an~integer~greater~
  than~or~equal~to~2;~the~parallel~marker~will~be~hidden.
}

% Split the pipe-delimited row list into matrix rows.
% Each row is wrapped in \shortstack so \\ creates a line break inside one
% data element instead of being treated as a new matrix row.
\cs_new_protected:Npn \__vsm_databox_build_body:n #1
  {
  \seq_set_split:Nnn \l__vsm_databox_items_seq { | } { #1 }
  \int_compare:nNnTF { \seq_count:N \l__vsm_databox_items_seq } < { 1 }
    { \msg_error:nn { vsm-commands } { missing-data-items } }
    {
    \tl_clear:N \l__vsm_databox_body_tl
    \seq_map_indexed_inline:Nn \l__vsm_databox_items_seq
    {
      \tl_put_right:Nn \l__vsm_databox_body_tl { \shortstack[l]{##2} }
      \int_compare:nNnT { ##1 } < { \seq_count:N \l__vsm_databox_items_seq }
        { \tl_put_right:Nn \l__vsm_databox_body_tl { \\ } }
    }
  }
}

% Resolve whether the second argument is a raw coordinate or an existing node.
% Linked data boxes inherit the parent width and sit 2mm below the parent so
% the box stays visually attached without manual sizing.
\cs_new_protected:Npn \__vsm_databox_set_position:n #1
  {
  \tl_if_in:nnTF { #1 } { , }
  {
    \dim_set:Nn \l__vsm_databox_width_dim { 3cm }
    \tl_set:Nn \l__vsm_databox_anchor_tl { center }
    \tl_set:Nn \l__vsm_databox_position_tl { (#1) }
  }
  {
    \path let \p1 = ($(#1.east)-(#1.west)$) in
          \pgfextra{\global\l__vsm_databox_width_dim=\x1\relax};
  \tl_set:Nn \l__vsm_databox_anchor_tl { north }
  \tl_set:Nn \l__vsm_databox_position_tl { ($(#1.south)+(0,-2mm)$) }
}
}

% Draw a dynamic data box.
% #1 optional TikZ node name for later references; defaults to DataBox.
% #2 either a coordinate such as 0,0 or an existing VSM node name. When a
%    node name is passed, the data box is placed below it and matches its width.
% #3 one or more pipe-delimited data rows. Use \\ inside a single row to create
%    a line break without creating an additional row.
\NewDocumentCommand{\vsmDataBox}{ O{DataBox} m +m }{%
\__vsm_databox_build_body:n { #3 }%
\__vsm_databox_set_position:n { #2 }%
% Use expl3-safe key names here: "~" preserves the embedded spaces that TikZ
% expects in keys such as "matrix of nodes" inside this inline key list.
\matrix[
matrix~of~nodes,
row~sep=-\pgflinewidth,
column~sep=0pt,
nodes={
draw,
minimum~width=\l__vsm_databox_width_dim,
text~width=\dim_eval:n { \l__vsm_databox_width_dim - 6pt },
inner~xsep=3pt,
inner~ysep=2pt,
align=left,
font=\vphantom{Q}
},
ampersand~replacement=\&
] (#1) [anchor=\l__vsm_databox_anchor_tl] at \l__vsm_databox_position_tl {
\tl_use:N \l__vsm_databox_body_tl \\
};
}
\ExplSyntaxOff

\newdimen\vsmLeadTimeBottomDim
\newdimen\vsmLeadTimeHighYDim
\newdimen\vsmLeadTimeLowYDim
\newdimen\vsmLeadTimeLeftDim
\newdimen\vsmLeadTimeRightDim
\newdimen\vsmLeadTimeCurrentYDim
\newdimen\vsmLeadTimePreviousRightDim
\newdimen\vsmLeadTimePreviousYDim
\newdimen\vsmLeadTimeProbeYDim
\newdimen\vsmLeadTimeLabelYDim
\newdimen\vsmLeadTimeSegmentTextWidthDim
\newif\ifvsmLeadTimeFirstSegment

\newcommand{\vsmLeadTimeSetLevel}[1]{%
\ifnum\pdfstrcmp{#1}{inventory}=0
\vsmLeadTimeCurrentYDim=\vsmLeadTimeHighYDim
\else\ifnum\pdfstrcmp{#1}{inventorybox}=0
\vsmLeadTimeCurrentYDim=\vsmLeadTimeHighYDim
\else\ifnum\pdfstrcmp{#1}{process}=0
\vsmLeadTimeCurrentYDim=\vsmLeadTimeLowYDim
\else\ifnum\pdfstrcmp{#1}{processbox}=0
\vsmLeadTimeCurrentYDim=\vsmLeadTimeLowYDim
\else
\PackageError{vsm-commands}
{\string\vsmLeadTimeLadder\space segment~type~'#1'~is~invalid}
{Use inventory, inventorybox, process, or processbox.}%
\fi\fi\fi\fi
}

\newcommand{\vsmLeadTimeIfInventory}[3]{%
\ifnum\pdfstrcmp{#1}{inventory}=0
#2%
\else\ifnum\pdfstrcmp{#1}{inventorybox}=0
#2%
\else
#3%
\fi\fi
}

% The public ladder macro intentionally uses a simple foreach-based layout:
% every segment inherits the exact width of its linked inventory/process node,
% then short connector runs bridge the gaps so the ladder stays continuous.
% #2 uses comma-delimited segments in the form:
%    type/node/time,type/node/time,...
\NewDocumentCommand{\vsmLeadTimeLadder}{ O{LeadTimeLadder} +m m m }{%
\path let \p1 = (current bounding box.south) in
    \pgfextra{\global\vsmLeadTimeBottomDim=\y1\relax};
\vsmLeadTimeHighYDim=\dimexpr\vsmLeadTimeBottomDim-7mm\relax
\vsmLeadTimeLowYDim=\dimexpr\vsmLeadTimeHighYDim-8mm\relax
\vsmLeadTimeLabelYDim=\dimexpr\vsmLeadTimeLowYDim-16mm\relax
\global\vsmLeadTimeFirstSegmenttrue
\foreach \segmenttype/\segmentnode/\segmenttime in {#2} {%
\path let \p1 = (\segmentnode.west), \p2 = (\segmentnode.east) in
      \pgfextra{%
        \global\vsmLeadTimeLeftDim=\x1\relax
\global\vsmLeadTimeRightDim=\x2\relax
\global\vsmLeadTimeSegmentTextWidthDim=\dimexpr\x2-\x1-2pt\relax
};
\vsmLeadTimeSetLevel{\segmenttype}%
\ifvsmLeadTimeFirstSegment
\global\vsmLeadTimeFirstSegmentfalse
\else
\draw[line width=0.9pt]
(\the\vsmLeadTimePreviousRightDim,\the\vsmLeadTimePreviousYDim)
--
(\the\vsmLeadTimeLeftDim,\the\vsmLeadTimePreviousYDim)
--
(\the\vsmLeadTimeLeftDim,\the\vsmLeadTimeCurrentYDim);
\fi
\draw[line width=0.9pt]
(\the\vsmLeadTimeLeftDim,\the\vsmLeadTimeCurrentYDim)
--
(\the\vsmLeadTimeRightDim,\the\vsmLeadTimeCurrentYDim);
\path
($ (\the\vsmLeadTimeLeftDim,\the\vsmLeadTimeLabelYDim)!0.5!(\the\vsmLeadTimeRightDim,\the\vsmLeadTimeLabelYDim) $)
coordinate (vsmLeadTimeLabelAnchor);
\path (vsmLeadTimeLabelAnchor)
node[
anchor=center,
inner sep=1pt,
font=\footnotesize,
fill=white,
text width=\the\vsmLeadTimeSegmentTextWidthDim,
align=center
]
{\segmenttime};
\global\vsmLeadTimePreviousRightDim=\vsmLeadTimeRightDim
\global\vsmLeadTimePreviousYDim=\vsmLeadTimeCurrentYDim
}%
\path
(
\the\vsmLeadTimePreviousRightDim,
\the\vsmLeadTimeHighYDim
)
++(6mm,0)
coordinate (vsmLeadTimeTotalsAnchor);
\node[
draw,
anchor=north west,
align=left,
inner xsep=4pt,
inner ysep=4pt,
minimum width=32mm
] (#1) at (vsmLeadTimeTotalsAnchor) {%
\begin{tabular}[t]{@{}l@{}}
Lead Time:\\
#3\\[2pt]
Process Time:\\
#4
\end{tabular}%
};
}

% Draw a wide open delivery arrow.
% #1 optional extra TikZ draw options.
% #2 optional centered textbox content; use \\ for internal line breaks.
% #3 start coordinate or node anchor.
% #4 end coordinate or node anchor.
\NewDocumentCommand{\vsmDeliveryArrow}{ O{} O{} m m }{%
\draw[
line width=1.4pt,
-{Triangle[open,length=12pt,width=14pt]},
#1
] (#3) -- (#4);
% Place the textbox at the midpoint if text is provided.
\if\relax\detokenize{#2}\relax\else
\node[
draw,
anchor=center,
align=center,
inner xsep=4pt,
inner ysep=2pt,
font=\footnotesize,
fill=white
] at ($(#3)!0.5!(#4)$) {#2};
\fi
}

% Draw a regular manual-information-flow arrow.
% #1 optional extra TikZ draw options.
% #2 start coordinate or node anchor.
% #3 end coordinate or node anchor.
\NewDocumentCommand{\vsmManualInformationFlow}{ O{} m m }{%
\draw[
semithick,
-{Stealth[length=8pt,width=10pt]},
#1
] (#2) -- (#3);
}

% Draw an electronic-information-flow arrow with two lightning-bolt corners.
% #1 optional extra TikZ draw options.
% #2 optional centered textbox content; use \\ for internal line breaks.
% #3 start coordinate or node anchor.
% #4 end coordinate or node anchor.
\NewDocumentCommand{\vsmElectronicInformationFlow}{ O{} O{} m m }{%
% The bend points are derived from the overall arrow angle so the same
% command works for horizontal, vertical, and diagonal connections.
\draw[
semithick,
-{Stealth[length=8pt,width=10pt]},
#1
]
let
\p1 = (#3),
\p2 = (#4),
\n1 = {atan2(\y2-\y1,\x2-\x1)}
in
(#3)
-- ($($(#3)!0.35!(#4)$) + (\n1+90:3mm)$)
-- ($($(#3)!0.65!(#4)$) + (\n1-90:3mm)$)
-- (#4);
% Place the textbox at the geometric midpoint between the endpoints so it
% stays visually centered on the overall arrow, not on one zig-zag segment.
\if\relax\detokenize{#2}\relax\else
\node[
draw,
fill=white,
inner xsep=3pt,
inner ysep=2pt,
align=center
] at ($ (#3)!0.5!(#4) $) {\shortstack[c]{#2}};
\fi
}

% Draw a bold push arrow with alternating black and white shaft segments.
% #1 optional extra TikZ draw options.
% #2 optional centered textbox content; use \\ for internal line breaks.
% #3 start coordinate or node anchor.
% #4 end coordinate or node anchor.
\NewDocumentCommand{\vsmPushArrow}{ O{} O{} m m }{%
% A white dashed overlay on top of the thick black shaft creates the blocked
% black/white segment look while a separate head keeps the arrow tip solid.
\draw[
line width=5pt,
line cap=butt,
#1
] (#3) -- (#4);
\draw[
white,
line width=2.6pt,
line cap=butt,
dash pattern=on 8pt off 8pt
] (#3) -- ($ (#3)!0.94!(#4) $);
\draw[
line width=1.2pt,
-{Triangle[length=10pt,width=12pt]},
#1
] ($ (#3)!0.9!(#4) $) -- (#4);
% Place the textbox at the midpoint if text is provided.
\if\relax\detokenize{#2}\relax\else
\node[
draw,
anchor=center,
align=center,
inner xsep=4pt,
inner ysep=2pt,
font=\footnotesize,
fill=white
] at ($(#3)!0.5!(#4)$) {#2};
\fi
}

% Draw a FIFO lane: two parallel rails spanning the connection, a "FIFO" label
% on a white patch in the middle, a short tick near the start, and a small
% arrowhead near the end to show flow direction. A "Max <cap> items" caption
% is placed below the lane, both rotated to follow the lane's direction so the
% symbol works for horizontal, vertical, or diagonal connections alike.
% #1 optional TikZ node name spanning the lane's bounding box, so the FIFO
%    lane can be referenced like an inventory node (e.g. by
%    \vsmLeadTimeLadder, since a FIFO lane also holds work-in-progress
%    inventory and therefore contributes waiting time); defaults to FIFOArrow.
% #2 optional extra TikZ draw options applied to the rails/tick/arrowhead.
% #3 start coordinate or node anchor.
% #4 end coordinate or node anchor.
% #5 maximum FIFO lane capacity shown as "Max #5 items".
\NewDocumentCommand{\vsmFIFOArrow}{ O{FIFOArrow} O{} m m m }{%
\node[fit={(#3) (#4)}, inner sep=0pt, minimum height=6mm] (#1) {};
\draw[line width=0.9pt, #2]
let \p1 = (#3), \p2 = (#4), \n1 = {atan2(\y2-\y1,\x2-\x1)} in
($(#3)+(\n1+90:2.5mm)$) -- ($(#4)+(\n1+90:2.5mm)$);
\draw[line width=0.9pt, #2]
let \p1 = (#3), \p2 = (#4), \n1 = {atan2(\y2-\y1,\x2-\x1)} in
($(#3)+(\n1-90:2.5mm)$) -- ($(#4)+(\n1-90:2.5mm)$);
\draw[line width=0.9pt, #2] ($(#3)!0.08!(#4)$) -- ($(#3)!0.22!(#4)$);
\draw[
line width=0.9pt,
-{Triangle[length=7pt,width=8pt]},
#2
] ($(#3)!0.72!(#4)$) -- ($(#3)!0.9!(#4)$);
\node[fill=white, inner sep=2pt, font=\footnotesize\bfseries]
at ($(#3)!0.5!(#4)$) {FIFO};
\path
let \p1 = (#3), \p2 = (#4), \n1 = {atan2(\y2-\y1,\x2-\x1)} in
      node[font=\footnotesize, align=center]
at ($ ($(#3)!0.5!(#4)$) + (\n1-90:6mm) $) {Max #5 items};
}

% Draw a conveyor connection: dashed vertical lines on left and right, solid
% horizontal lines at top and bottom, and a rotated "Conveyor" label in the
% middle. The symbol adapts its orientation to the angle of the connection
% from #3 to #4 (works for horizontal, vertical, or diagonal connections).
% #1 optional TikZ node name spanning the conveyor's bounding box for later
%    reference; defaults to ConveyorArrow.
% #2 optional extra TikZ draw options applied to all lines.
% #3 start coordinate or node anchor.
% #4 end coordinate or node anchor.
\NewDocumentCommand{\vsmConveyor}{ O{ConveyorArrow} O{} m m }{%
\node[fit={(#3) (#4)}, inner sep=0pt, minimum height=5mm] (#1) {};
% Left dashed line
\draw[line width=0.9pt, dashed, #2]
let \p1 = (#3), \p2 = (#4), \n1 = {atan2(\y2-\y1,\x2-\x1)} in
($(#3)+(\n1+90:2mm)$) -- ($(#4)+(\n1+90:2mm)$);
% Right dashed line
\draw[line width=0.9pt, dashed, #2]
let \p1 = (#3), \p2 = (#4), \n1 = {atan2(\y2-\y1,\x2-\x1)} in
($(#3)+(\n1-90:2mm)$) -- ($(#4)+(\n1-90:2mm)$);
% Top solid line
\draw[line width=0.9pt, #2]
let \p1 = (#3), \p2 = (#4), \n1 = {atan2(\y2-\y1,\x2-\x1)} in
($(#3)+(\n1+90:2mm)$) -- ($(#3)+(\n1-90:2mm)$);
% Bottom solid line
\draw[line width=0.9pt, #2]
let \p1 = (#3), \p2 = (#4), \n1 = {atan2(\y2-\y1,\x2-\x1)} in
($(#4)+(\n1+90:2mm)$) -- ($(#4)+(\n1-90:2mm)$);
% Conveyor label rotated to match connection angle
\path
let \p1 = (#3), \p2 = (#4), \n1 = {atan2(\y2-\y1,\x2-\x1)} in
      node[font=\footnotesize\bfseries, rotate=\n1]
        at ($(#3)!0.5!(#4)$) {Conveyor};
}

% Draw the worker/count row for a process box when the optional worker count is
% a positive integer. The icon uses a head circle plus a wider lower arc to
% suggest shoulders, matching the task's requested worker silhouette.
\ExplSyntaxOn
\cs_new_protected:Npn \__vsm_process_maybe_worker:n #1
{
\tl_if_blank:nF { #1 }
{
\regex_match:nnTF { \A \s* [1-9]\d* \s* \Z } { #1 }
{
\\[2pt]
\tikz[baseline=(workerlabel.base)]{
\draw[line~width=0.45pt] (0,1.2ex) circle[radius=0.65ex];
\draw[line~width=0.45pt]
(-1.45ex,-0.1ex)
arc[start~angle=200,end~angle=340,x~radius=1.45ex,y~radius=0.95ex];
\node[anchor=base~west, inner~sep=0pt] (workerlabel) at (2.2ex,0.2ex) {#1};
}
}
{ \msg_warning:nnn { vsm-commands } { invalid-worker-count } { #1 } }
}
}

% Draw the parallel-process marker when the optional parallel count is an
% integer of 2 or larger. Drawing only the exposed outline keeps the extra box
% visually stacked behind the main process box while avoiding overlaps with the
% foreground box content. Counts above 2 also show an `xN` multiplier beside it.
\cs_new_protected:Npn \__vsm_process_maybe_parallel:nn #1#2
{
\tl_if_blank:nF { #2 }
{
\regex_match:nnTF { \A \s* \d+ \s* \Z } { #2 }
{
\int_compare:nNnT { \int_eval:n { #2 } } > { 1 }
{
\draw[line~width=0.45pt]
let
\p1 = (#1.west),
\p2 = (#1.east),
\p3 = (#1.south),
\p4 = (#1.north),
\n1 = {0.82*(\x2-\x1)},
\n2 = {0.78*(\y4-\y3)},
\n3 = {0.5*(\y4-\y3)}
in
($ (#1.east) + (0,-\n3) + (3mm,-3mm) + (-2.5mm,\n2) $)
-- ($ (#1.east) + (0,-\n3) + (3mm,-3mm) + (0,\n2) $)
-- ($ (#1.east) + (0,-\n3) + (3mm,-3mm) $)
-- ($ (#1.east) + (0,-\n3) + (3mm,-3mm) + (-\n1,0) $)
-- ($ (#1.east) + (0,-\n3) + (3mm,-3mm) + (-\n1,3mm) $);
\int_compare:nNnT { \int_eval:n { #2 } } > { 2 }
{
\path
let
                       \p1 = (#1.west),
                       \p2 = (#1.east),
                       \p3 = (#1.south),
                       \p4 = (#1.north),
                       \n1 = {0.5*(\y4-\y3)}
                     in
                       node[anchor=base~west, inner~sep=0pt, font=\footnotesize]
                       at ($ (#1.east) + (0,-\n1) + (3.0mm,-1.5mm) $) {x#2};
                 }
             }
         }
         { \msg_warning:nnn { vsm-commands } { invalid-parallel-count } { #2 } }
}
}

% Draw a process box with a title row and a description row.
% #1 optional TikZ node name for later references; defaults to Process.
% #2 coordinate where the process box is centered.
% #3 bold process title shown in the top half.
% #4 description text shown in the lower half; use \\ for line breaks.
% #5 optional worker count. Positive integers add a worker icon and the count
%    in the lower-left of the box underneath the description text.
% #6 optional parallel count. Values of 2 or more add a smaller stacked box at
%    the lower-right; values above 2 also show an `xN` multiplier there.
\NewDocumentCommand{\vsmProcess}{ O{Process} m m m O{} O{} }{%
\node[
draw,
text~width=3cm,
shape=rectangle~split,
rectangle~split~parts=2,
rectangle~split~part~fill={black!10,white},
font=\vphantom{Q}
] (#1) at (#2) {\textbf{#3} \nodepart{two} \shortstack[l]{#4\__vsm_process_maybe_worker:n {#5}}};
\__vsm_process_maybe_parallel:nn {#1} {#6}
}
\ExplSyntaxOff

% Draw a workcell outline with a label above it.
% #1 optional TikZ node name for later references; defaults to Workcell.
% #2 coordinate where the workcell is centered.
% #3 label text shown above the workcell.
\newcommand{\vsmWorkcell}[3][Workcell]{%
\node[
minimum width=3em,
minimum height=3em,
label={[label distance=0.5em]90:{\footnotesize #3}}
] (#1) at (#2) {};
\draw (#1.south west) -- (#1.north west) -- (#1.north east) -- (#1.south east) --
++(-1em,0) -- ++(0,2em) -- ++(-1em,0) -- ++(0,-2em) -- cycle;
}

% Draw a kaizen burst shape: a starburst with centered text.
% #1 optional TikZ node name for later references; defaults to KaizenBurst.
% #2 coordinate where the burst is centered.
% #3 text lines separated by \\ (max 2 lines, max 12 symbols per line);
%    width adapts to text content.
\NewDocumentCommand{\vsmKaizenBurst}{ O{KaizenBurst} m +m }{%
\node[inner sep=0pt, font=\footnotesize, opacity=0]
(#1-text) at (#2) {\shortstack[c]{#3}};
\coordinate (#1-right) at
($ (#1-text.center)!1.8!(#1-text.east) + (0.2cm,0) $);
\coordinate (#1-left) at
($ (#1-text.center)!1.8!(#1-text.west) + (-0.2cm,0) $);
\node[
fit={(#1-left) (#1-right)},
minimum width=1.5cm,
minimum height=1.5cm,
inner sep=0pt
] (#1) {};
\begin{pgfonlayer}{vsm foreground}
\begin{scope}[
shift={(#1.center)},
x={($(#1.east)-(#1.center)$)},
y={($(#1.north)-(#1.center)$)}
]
\draw[fill=black!10, line width=0.75pt]
(0,1) -- (0.1438,0.5369) -- (0.5,0.8660) -- (0.3928,0.3928) --
(0.8660,0.5) -- (0.5369,0.1438) -- (1,0) -- (0.5369,-0.1438) --
(0.8660,-0.5) -- (0.3928,-0.3928) -- (0.5,-0.8660) --
(0.1438,-0.5369) -- (0,-1) -- (-0.1438,-0.5369) --
(-0.5,-0.8660) -- (-0.3928,-0.3928) -- (-0.8660,-0.5) --
(-0.5369,-0.1438) -- (-1,0) -- (-0.5369,0.1438) --
(-0.8660,0.5) -- (-0.3928,0.3928) -- (-0.5,0.8660) --
(-0.1438,0.5369)
-- cycle;
\end{scope}
\node[inner sep=0pt, font=\footnotesize]
at (#2) {\shortstack[c]{#3}};
\end{pgfonlayer}
}
